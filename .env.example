# ===============================================
# BankOS Frontend - Environment Variables Template (Flutter)
# Copy this file to .env and define your real values.
# NEVER commit the real .env file with secrets to Git.
# ===============================================

# Base URL for the Backend API (BankOS_Backend)
API_BASE_URL=http://localhost:3000/api/v1
APP_ENVIRONMENT=development

# Public third-party service keys (e.g. Sentry, Firebase if applicable)
# NEVER place private API keys or service account credentials here.
